# ========================
# Dependencies
# ========================
node_modules/
frontend/node_modules/

# ========================
# Frontend build output
# ========================
frontend/build/
frontend/dist/

# ========================
# Backend (.NET)
# ========================
# Match any project's build output, not just Backend/ - Backend.Tests/bin and
# Backend.Tests/obj were previously committed because they were not covered.
[Bb]in/
[Oo]bj/

# ========================
# Local secrets (never commit)
# ========================
# Backend config comes from user-secrets / environment variables.
appsettings.*.local.json
secrets.json

# ========================
# Testing
# ========================
coverage/
# Unanchored: Playwright writes these relative to wherever it was invoked from.
playwright-report/
test-results/
blob-report/
.playwright/
# A frontend build made against a throwaway API, for E2E runs.
frontend/build-e2e/

# ========================
# Vite
# ========================
frontend/.vite/
frontend/node_modules/.vite/
*.local

# ========================
# Environment files
# ========================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
frontend/.env

# ========================
# Logs
# ========================
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ========================
# OS / Editor junk
# ========================
.DS_Store
.vscode/

.fake