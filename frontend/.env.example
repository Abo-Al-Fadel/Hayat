# Copy to .env and adjust for your environment.
# Only variables prefixed with REACT_APP_ (or VITE_) are exposed to the bundle.

# Base URL of the Hayat backend API (no trailing slash).
REACT_APP_API_BASE=http://localhost:5057

# Public demo account, displayed on the login page so a visitor can look around
# without being given a password. Leave both unset to hide the panel entirely.
#
# These end up in the compiled JavaScript, so treat them as public. That is only
# acceptable because the backend seeds this account as the read-only HR role and
# hard-codes that role - see DemoAccount:* in the API configuration. Never point
# these at an account that can write.
#REACT_APP_DEMO_USER=Hr
#REACT_APP_DEMO_PASS=change-me
