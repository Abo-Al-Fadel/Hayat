# Copy to .env and adjust for your environment.
# Only variables prefixed with REACT_APP_ (or VITE_) are exposed to the bundle.

# Base URL of the Hayat backend API (no trailing slash).
REACT_APP_API_BASE=http://localhost:5057

# Public demo account, displayed on the login page so a visitor can look around
# without being given a password.
#
# Not required: the credentials are hard-coded in src/Pages/Login.tsx so the demo
# works on every deployment without per-host setup. Set these only to use different
# credentials, or set REACT_APP_DEMO_USER empty to hide the panel entirely.
#
# They end up in the compiled JavaScript either way, so treat them as public. That
# is only acceptable because the account holds the read-only HR role. Never point
# these at an account that can write.
#REACT_APP_DEMO_USER=Hr
#REACT_APP_DEMO_PASS=change-me
